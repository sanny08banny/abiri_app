<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        android:elevation="8dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/image"
                    android:maxHeight="500dp"
                    android:src="@drawable/baseline_downloading_350"
                    android:scaleType="fitXY" />

<!--                <ImageButton-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:id="@+id/options"-->
<!--                    android:src="@drawable/baseline_more_vert_28"-->
<!--                    android:layout_weight="0"-->
<!--                    android:layout_margin="8dp"-->
<!--                    android:layout_gravity="end"-->
<!--                    android:background="@android:color/transparent"-->
<!--                    app:tint="?attr/imageButtonStyle"-->
<!--                    android:layout_marginHorizontal="12dp"/>-->
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:shapeAppearanceOverlay="@style/RoundedImageView"
                    android:src="@drawable/baseline_account_balance_wallet_24"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/logo"
                    android:layout_marginHorizontal="8dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Wallet"
                    android:id="@+id/dest_name"
                    android:textStyle="bold"
                    android:layout_gravity="center_vertical"
                    android:textSize="12sp"
                    android:fontFamily="@font/actor"
                    android:layout_marginVertical="8dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/description"
                android:layout_marginVertical="8dp"
                android:layout_marginStart="16dp"
                android:textStyle="bold"
                android:fontFamily="@font/jost_semibold"
                android:textSize="16sp"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/like"
                    android:contentDescription="@string/like"
                    android:src="@drawable/thumb_like_icon"
                    android:layout_margin="6dp"
                    android:layout_gravity="end"
                    android:background="@android:color/transparent"
                    app:tint="?attr/imageButtonStyle"
                    android:layout_marginHorizontal="12dp"/>
                <TextView
                    android:id="@+id/likes_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8"
                    android:padding="3dp"
                    android:gravity="center_vertical"/>
                <ImageButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/dislike"
                    android:contentDescription="@string/dislike"
                    android:src="@drawable/fluent_thumb_dislike_icon"
                    android:layout_margin="8dp"
                    android:layout_gravity="end"
                    android:background="@android:color/transparent"
                    app:tint="?attr/imageButtonStyle"
                    android:layout_marginHorizontal="12dp"/>
                <TextView
                    android:id="@+id/dislikes_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8"
                    android:padding="3dp"
                    android:gravity="center_vertical"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>