<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:elevation="8dp"
        app:cardCornerRadius="16dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:background="@color/custom_gray"
        android:layout_height="match_parent">

        <!-- Car Hire Details -->
        <LinearLayout
            android:id="@+id/car_hire_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <!-- Add your details here, such as text views for car name, price, etc. -->

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price: $100/day"
                android:layout_marginTop="8dp"
                android:layout_marginStart="6dp"
                android:textColor="@android:color/darker_gray"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Car Name"
                android:layout_gravity="center_horizontal"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/duration_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="12dp"
                android:text=""
                app:icon="@drawable/access_time_24px"
                app:iconGravity="end"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:backgroundTint="@color/white"
                app:iconTint="@color/black" />
        </LinearLayout>

        <!-- Image with Faded Mask -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="150dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/car_image"
                android:layout_width="100dp"
                android:layout_height="150dp"
                android:scaleType="centerCrop"
                android:src="@drawable/rental_01"/>

            <!-- Faded Mask -->
            <View
                android:id="@+id/image_mask"
                android:layout_width="33.33dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@drawable/image_mask"/>
        </FrameLayout>

    </RelativeLayout>
    </androidx.cardview.widget.CardView>

</layout>