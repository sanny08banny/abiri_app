<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PopupMenuStyle" parent="@style/Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/custom_popup_background</item>
        <!-- Add other style attributes as needed -->
    </style>
    <style name="AdminNewProductAnimation">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>
    <style name="RoundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="MyFloatingActionButtonStyle" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="elevation">4dp</item> <!-- Shadow depth -->
        <item name="pressedTranslationZ">6dp</item> <!-- Effect on press -->
        <item name="fabSize">normal</item> <!-- Size: 'normal' or 'mini' -->
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="imageButtonStyle">@color/black</item>
        <item name="backgroundColor">@color/white</item>
        <item name="customColorValue">@color/transparent_white</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
</resources>